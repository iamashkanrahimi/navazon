# Telegram Bot API
BOT_TOKEN=
BOT_USERNAME=Navazonbot

# Telegram MTProto proxy account
TG_API_ID=
TG_API_HASH=
TG_STRING_SESSION=
PROXY_USER_ID=

# PostgreSQL / Neon
DATABASE_URL=

# Webhook + crawler/admin protection
WEBHOOK_SECRET=
CRAWLER_TOKEN=
ADMIN_TOKEN=

# Sources
MELOBOT_USERNAME=melobot
AHANGIFY_USERNAME=ahangifybot
BRAND_CAPTION=@NavazonBot

# Optional Spotify + Musixmatch enrichment pilot
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
MUSIXMATCH_API_KEY=
SPOTIFY_MUSIXMATCH_PILOT_ENABLED=false

# Availability policy (enforcement stays off until you intentionally enable it)
FOREIGN_DEFAULT_POLICY=iran_only
REGION_ENFORCEMENT_ENABLED=false

# Source timeouts
SEARCH_TIMEOUT_MS=18000
DOWNLOAD_TIMEOUT_MS=90000

# Metadata freshness
CATALOG_ARTIST_TTL_HOURS=72
CATALOG_ALBUMS_TTL_HOURS=168
CATALOG_EMPTY_ALBUMS_TTL_HOURS=72
CATALOG_ALBUM_TRACKS_TTL_HOURS=720

# Crawler (v1.1 deep catalog uses a persistent Neon task queue)
DISCOVERY_ENABLED=true
DISCOVERY_IDLE_MINUTES=8
DISCOVERY_HEAVY_IDLE_MINUTES=25
DISCOVERY_ARTIST_MIN_AGE_HOURS=168
DISCOVERY_ALBUMS_PER_RUN=1
DISCOVERY_CONTINUE_MINUTES=2
DISCOVERY_RETRY_HOURS=6
DISCOVERY_USE_AHANGIFY=true
DISCOVERY_WARM_TOP_TRACKS=0
# Deep Catalog v1.1 still caches HQ/normal files through crawl_tasks; the legacy warm setting above can remain 0.
